{
  "name": "hello-vers",
  "version": "0.1.0",
  "private": true,
  "description": "A hands-on guide to Vers, running on Bun and PostgreSQL.",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun run frontend/server.ts",
    "dev": "bun --watch frontend/server.ts",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
